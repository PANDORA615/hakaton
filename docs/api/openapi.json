  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "id": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "exclusiveMinimum": 0.0,
            "title": "Id"
          },
          "email": {
            "type": "string",
            "maxLength": 320,
            "minLength": 3,
            "title": "Email"
          },
          "balance": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Balance"
          },
          "withdrawBalance": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Withdrawbalance"
          },
          "totalReplenished": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Totalreplenished"
          },
          "bonusBalance": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Bonusbalance"
          },
          "bonusState": {
            "type": "string",
            "enum": [
              "locked",
              "unlocked"
            ],
            "title": "Bonusstate"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "email",
          "balance",
          "withdrawBalance",
          "totalReplenished",
          "bonusBalance",
          "bonusState"
        ],
        "title": "Account"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Login": {
        "properties": {
          "login": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Login"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "login",
          "password"
        ],
        "title": "Login"
      },
      "Service": {
        "properties": {
          "id": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "exclusiveMinimum": 0.0,
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9-]+$",
            "title": "Name"
          },
          "ownerId": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "exclusiveMinimum": 0.0,
            "title": "Ownerid"
          },
          "paymentTerm": {
            "type": "string",
            "enum": [
              "hour",
              "week",
              "month",
              "quarter_year",
              "half_year",
              "year"
            ],
            "title": "Paymentterm"
          },
          "autoProlong": {
            "type": "boolean",
            "title": "Autoprolong"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "title": "Expiresat"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "blocked",
              "deleted",
              "suspended",
              "prolong_wait"
            ],
            "title": "Status"
          },
          "price": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Price"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "ownerId",
          "paymentTerm",
          "autoProlong",
          "createdAt",
          "expiresAt",
          "status",
          "price"
        ],
        "title": "Service"
      },
      "SettingsPatch": {
        "properties": {
          "expected_settings_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Settings Version"
          },
          "weights": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weights"
          },
          "horizon_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Horizon Days"
          },
          "urgency_days": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Urgency Days"
          },
          "medium_threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Medium Threshold"
          },
          "high_threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "High Threshold"
          },
          "coverage_threshold": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Coverage Threshold"
          },
          "funded_multiplier": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Funded Multiplier"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SettingsPatch"
      },
      "Snapshot": {
        "properties": {
          "accounts": {
            "items": {
              "$ref": "#/components/schemas/Account"
            },
            "type": "array",
            "maxItems": 100000,
            "title": "Accounts"
          },
          "services": {
            "items": {
              "$ref": "#/components/schemas/Service"
            },
            "type": "array",
            "maxItems": 300000,
            "title": "Services"
          },
          "transactions": {
            "items": {
              "$ref": "#/components/schemas/Transaction"
            },
            "type": "array",
            "maxItems": 1000000,
            "title": "Transactions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accounts",
          "services",
          "transactions"
        ],
        "title": "Snapshot"
      },
      "Transaction": {
        "properties": {
          "id": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "exclusiveMinimum": 0.0,
            "title": "Id"
          },
          "amount": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Amount"
          },
          "status": {
            "type": "string",
            "enum": [
              "performed",
              "not_performed"
            ],
            "title": "Status"
          },
          "performedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Performedat"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          },
          "type": {
            "type": "string",
            "enum": [
              "order",
              "prolong"
            ],
            "title": "Type"
          },
          "serviceId": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "exclusiveMinimum": 0.0,
            "title": "Serviceid"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "amount",
          "status",
          "performedAt",
          "createdAt",
          "type",
          "serviceId"
        ],
        "title": "Transaction"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "aeza_session"
      },
      "MetricsBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
