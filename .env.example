# Copy to .env and replace all three empty values before starting.
# Use letters and digits for POSTGRES_PASSWORD (it is used inside a connection URL).
POSTGRES_PASSWORD=
ADMIN_LOGIN=admin
# At least 12 characters; used only when creating the FIRST admin.
ADMIN_PASSWORD=
METRICS_TOKEN=
APP_BIND=127.0.0.1
APP_PORT=8080
COOKIE_SECURE=false
# Optional OIDC sign-in. Fill every value to enable; otherwise leave all empty.
# Register the exact callback URI at the identity provider. Use HTTPS.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_CALLBACK_URL=
# Exact OIDC subject allowed to access the local administrator account.
OIDC_ALLOWED_SUB=
# Random secret, at least 32 characters, for the temporary authorization-flow cookie.
OIDC_SESSION_SECRET=
# Fixed clock for the original fixture. For live UTC set ANALYSIS_AS_OF= (empty).
ANALYSIS_AS_OF=2026-10-19T15:00:00Z
# Empty ANALYSIS_AS_OF enables live UTC; remove it to use the default fixed demo date.
RETENTION_RUN_LIMIT=200
RETENTION_SNAPSHOT_LIMIT=100
